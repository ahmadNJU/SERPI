# Editorial access token guarding /api/papers and /api/download.
# Use a long, random secret. Required.
EDITOR_TOKEN=change-me-to-a-long-random-secret

# Neon (Netlify DB) connection string — provisioned by the Netlify DB extension.
NETLIFY_DATABASE_URL=

# Transactional email (optional). If RESEND_API_KEY is unset, emails are
# skipped and submissions still succeed.
RESEND_API_KEY=
MAIL_FROM=ERPI Editorial Office <no-reply@your-domain>
EDITORIAL_EMAIL=editors@serpi-journal.org
