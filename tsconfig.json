{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".build"
  },
  "include": ["db/**/*", "netlify/**/*"],
  "exclude": ["node_modules"]
}
